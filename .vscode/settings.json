{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.wrangler/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.wrangler": true
  },
  "typescript.tsserver.maxTsServerMemory": 512,
  "editor.renderWhitespace": "selection",
  "editor.minimap.enabled": false
}
